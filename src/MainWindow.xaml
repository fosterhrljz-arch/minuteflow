<Window x:Class="MinuteFlow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MinuteFlow — Private Offline Meeting Minutes" Width="1220" Height="800" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F7F7F8" FontFamily="Segoe UI" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E6E6E8" BorderThickness="0,0,0,1" Padding="32,0">
   <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#191A1C" Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"><TextBlock Text="m" Foreground="White" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border>
     <TextBlock Text="MinuteFlow" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock Text="/" Foreground="#D1D2D6" Margin="20,0" FontSize="22" VerticalAlignment="Center"/>
     <TextBlock Text="Private Meetings. Local Intelligence." Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="13"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Border Background="#F2F5F2" CornerRadius="14" Padding="12,6" Margin="0,0,12,0"><TextBlock Text="●  100% Offline" Foreground="#41604B" FontSize="12" FontWeight="SemiBold"/></Border>
     <Button Content="Privacy &amp; help" Click="Privacy_Click" Padding="12,8"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="32,24,32,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20">
    <StackPanel><TextBlock Text="Make room for the conversation." FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Turn recordings and rough notes into clear, editable meeting minutes. Everything stays here." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0"/></StackPanel>
    <Button x:Name="NewButton" Content="New meeting" Click="New_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
   <Border Grid.Row="1" Background="White" CornerRadius="14" BorderBrush="#E3E4E7" BorderThickness="1" Padding="20,17" Margin="0,0,0,20">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="START WITH YOUR SOURCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="AudioButton" Content="↑  Import recording" Click="Audio_Click" Background="#202124" Foreground="White" BorderBrush="#202124"/><Button x:Name="NotesButton" Content="Import notes" Click="Notes_Click" Margin="10,0,0,0"/><Button x:Name="SampleButton" Content="Try an example" Click="Sample_Click" Margin="10,0,0,0" BorderThickness="0"/></StackPanel><TextBlock Text="MP3, WAV, M4A · TXT, MD · or paste below" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="20,0,26,0" VerticalAlignment="Center"><TextBlock Text="Recording language" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="LanguageBox" Width="150" Height="32" SelectedIndex="0" AutomationProperties.Name="Recording language"><ComboBoxItem Content="Auto-detect"/><ComboBoxItem Content="English"/><ComboBoxItem Content="Chinese"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="No Cloud Uploads" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="No accounts. No autosave." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/><TextBlock x:Name="ModelLabel" Text="Bundled Whisper · English + Chinese" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*" MinWidth="340"/></Grid.ColumnDefinitions>
    <Border Background="White" CornerRadius="14" BorderBrush="#E3E4E7" BorderThickness="1">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="20,17"><StackPanel><TextBlock Text="01  /  Source" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SourceLabel" Text="Your notes or original transcript" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="350" HorizontalAlignment="Left"/></StackPanel><Button Content="Export source" Click="ExportSource_Click" HorizontalAlignment="Right" Padding="10,6" FontSize="11"/></Grid>
      <Border Grid.Row="1" BorderBrush="#ECECEF" BorderThickness="0,1,0,1" Padding="20,9"><TextBox x:Name="MeetingTitle" Text="Untitled meeting" FontSize="13" FontWeight="SemiBold" MaxLength="160" AutomationProperties.Name="Meeting title" TextChanged="Title_Changed"/></Border>
      <Grid Grid.Row="2" Margin="18,14"><TextBox x:Name="SourceBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="200000" TextChanged="Source_Changed" AutomationProperties.Name="Source transcript and notes"/><TextBlock x:Name="SourcePlaceholder" Text="Paste your meeting notes here…&#10;&#10;Or import a recording to transcribe it on this device.&#10;&#10;Tip: use Owner: and Deadline: to identify action details explicitly." Foreground="#92959D" Margin="5,5" FontSize="14" LineHeight="25" IsHitTestVisible="False" TextWrapping="Wrap"/></Grid>
      <Border Grid.Row="3" BorderBrush="#ECECEF" BorderThickness="0,1,0,0" Padding="20,11"><Grid><TextBlock x:Name="SourceCount" Text="0 characters" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="Editable · kept in memory" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid></Border>
     </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent"/>
    <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#E3E4E7" BorderThickness="1">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="20,17"><StackPanel><TextBlock Text="02  /  Meeting minutes" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Transparent, rule-based extraction" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" Padding="10,6" FontSize="11" IsEnabled="False"/><Button x:Name="ExportButton" Content="Export…" Click="Export_Click" Padding="10,6" FontSize="11" Margin="8,0,0,0" IsEnabled="False"/></StackPanel></Grid>
      <Border Grid.Row="1" Background="#F8F8F9" BorderBrush="#ECECEF" BorderThickness="0,1,0,1" Padding="20,13"><TextBlock x:Name="ReviewLabel" Text="Source wording preserved. Missing details stay unspecified." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></Border>
      <Grid Grid.Row="2" Margin="18,14"><TextBox x:Name="MinutesBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Minutes_Changed" AutomationProperties.Name="Editable meeting minutes"/><StackPanel x:Name="MinutesPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Clarity starts here." FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Summary. Decisions. Next steps." FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="Add a source, then generate your minutes." FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid>
      <Border Grid.Row="3" BorderBrush="#ECECEF" BorderThickness="0,1,0,0" Padding="20,11"><Grid><TextBlock x:Name="ResultCount" Text="Ready when you are" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="Editable Markdown" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid></Border>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="3" Margin="0,18,0,0">
    <StackPanel VerticalAlignment="Center" Margin="0,0,250,0"><TextBlock x:Name="StatusLabel" Text="Your workspace is private. Export only when you choose." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0" Foreground="#666B74"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,10,0"/><Button x:Name="GenerateButton" Content="Generate Minutes  →" Click="Generate_Click" Background="#202124" BorderBrush="#202124" Foreground="White" Padding="23,13" IsEnabled="False"/></StackPanel>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#E6E6E8" BorderThickness="0,1,0,0" Padding="32,0"><Grid><TextBlock Text="LOCAL BY DESIGN" FontSize="9" FontWeight="Bold" Foreground="#8A8D94" VerticalAlignment="Center"/><TextBlock Text="No network requests  ·  No meeting history  ·  No background saving" FontSize="10" Foreground="#8A8D94" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>
